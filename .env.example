# ---------- Server ----------
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
APP_VERSION=1.0.0.20261126
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
AUTO_SEED=true
LOG_LEVEL=info
# LOG_PRETTY=true

# Public URL used for the browser-facing application.
# PUBLIC_URL=https://itsm.example.com
# Optional. URL that Zabbix uses to reach the Webhook endpoint.
# Use the server's internal address when Zabbix is on the internal network.
# WEBHOOK_PUBLIC_URL=http://10.0.0.16

# CORS: empty means reflect the request origin. Set explicit origins in production.
# CORS_ORIGIN=https://itsm.example.com

# ---------- Database ----------
# Default: embedded SQLite. Zero external dependency.
DB_CLIENT=better-sqlite3
DB_FILE=data/itsm.db
DATA_DIR=data

# ---------- PostgreSQL ----------
# DB_CLIENT=pg
# DATABASE_URL=postgres://nextitops:change-me@127.0.0.1:5432/nextitops
# or:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=nextitops
# DB_USER=nextitops
# DB_PASSWORD=change-me
# DB_SSL=false
# DB_POOL_MAX=10

# ---------- MySQL 8+ ----------
# DB_CLIENT=mysql2
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=nextitops
# DB_USER=nextitops
# DB_PASSWORD=change-me
# DB_SSL=false
# DB_POOL_MAX=10

# ---------- Zabbix ----------
ZABBIX_TIMEOUT_MS=10000
ZABBIX_HOST_SYNC_MINUTES=5
